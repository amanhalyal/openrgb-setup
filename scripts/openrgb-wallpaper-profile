#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-or-later

set -u

wallpaper_path="${1:-}"
script_path="$(readlink -f "${BASH_SOURCE[0]}")"
script_dir="$(dirname -- "$script_path")"
repository_dir="$(cd -- "$script_dir/.." && pwd)"
profile_dir="${OPENRGB_PROFILE_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/OpenRGB/profiles}"
mapping_file="${OPENRGB_WALLPAPER_MAP:-$repository_dir/config/wallpaper-profiles.tsv}"
if [[ -z "$wallpaper_path" ]]; then
    wallpaper_path="$(timeout 5 /usr/bin/noctalia msg wallpaper-get 2>/dev/null | head -n 1)"
fi

# Wallpapers live in ~/Wallpapers. The data file matches basenames so absolute
# paths emitted by Noctalia do not embed a user-specific directory in mappings.
wallpaper_filename="${wallpaper_path##*/}"
profile_filename=""
if [[ -f "$mapping_file" ]]; then
    while IFS=$'\t' read -r mapped_wallpaper mapped_profile; do
        [[ -n "$mapped_wallpaper" && "$mapped_wallpaper" != \#* ]] || continue
        if [[ "$mapped_wallpaper" == "$wallpaper_filename" ]]; then
            profile_filename="${mapped_profile%$'\r'}"
            break
        fi
    done <"$mapping_file"
fi

[[ -n "$profile_filename" ]] || exit 0
[[ "$profile_filename" != */* && "$profile_filename" != '.' && "$profile_filename" != '..' ]] || {
    /usr/bin/logger -t openrgb-wallpaper "invalid mapped profile name for $wallpaper_filename"
    exit 1
}
profile="$profile_dir/$profile_filename"

if [[ ! -f "$profile" ]]; then
    /usr/bin/logger -t openrgb-wallpaper "profile not found: $profile"
    exit 1
fi

runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
state_file="$runtime_dir/openrgb-wallpaper-profile.current"

exec 9>"$runtime_dir/openrgb-wallpaper-profile.lock"
# Profile application can take several seconds while ENE hardware is verified.
# Queue a newer wallpaper event instead of silently dropping it while another
# event holds the lock. Duplicate monitor events are skipped by the state file
# after they acquire the lock.
if ! /usr/bin/flock -w 60 9; then
    /usr/bin/logger -t openrgb-wallpaper "timed out waiting to apply ${profile##*/} for ${wallpaper_path##*/}"
    exit 1
fi

if [[ "${OPENRGB_FORCE:-0}" != 1 ]] && [[ -f "$state_file" ]] && [[ "$(<"$state_file")" == "$profile" ]]; then
    exit 0
fi

# At login this hook races the XDG autostart entry.  Let the server complete its
# initial scan before asking it to load the selected profile.
server_unit="app-openrgb@autostart.service"
/usr/bin/systemctl --user start "$server_unit" >/dev/null 2>&1

server_pid="$(/usr/bin/systemctl --user show --property MainPID --value "$server_unit")"
if [[ ! "$server_pid" =~ ^[1-9][0-9]*$ ]]; then
    /usr/bin/logger -t openrgb-wallpaper "OpenRGB server did not start"
    exit 1
fi

# Normal detection currently takes about 1.5 seconds, but the first scan after
# boot can take longer.  Wait until the server process is at least five seconds
# old without delaying ordinary wallpaper changes on an established session.
server_age="$(/usr/bin/ps -o etimes= -p "$server_pid" 2>/dev/null | /usr/bin/tr -d ' ')"
if [[ "$server_age" =~ ^[0-9]+$ ]] && (( server_age < 5 )); then
    /usr/bin/sleep "$((5 - server_age))"
fi

output="$(timeout 40 "$script_dir/openrgb-apply-profile" "$profile" 2>&1)"
status=$?
[[ -n "$output" ]] && printf '%s\n' "$output"

if (( status != 0 )); then
    /usr/bin/logger -t openrgb-wallpaper "failed to apply ${profile##*/} for ${wallpaper_path##*/} (status $status): ${output//$'\n'/; }"
    exit 1
fi

printf '%s\n' "$profile" >"$state_file"
/usr/bin/logger -t openrgb-wallpaper "hardware-verified ${profile##*/} for ${wallpaper_path##*/}"
exit 0
