#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-or-later

set -euo pipefail

profile="${1:-}"
server_unit="app-openrgb@autostart.service"
script_path="$(readlink -f "${BASH_SOURCE[0]}")"
repository_dir="$(cd -- "$(dirname -- "$script_path")/.." && pwd)"

if [[ -z "$profile" || ! -s "$profile" ]]; then
    printf 'Usage: %s PROFILE.json\n' "$0" >&2
    exit 2
fi

# Keep one OpenRGB process in sole ownership of the hardware. The OpenRGB 1.0
# standalone CLI races its asynchronous mode update against its synchronous LED
# update on ENE controllers, which can leave a DIMM partially programmed.
/usr/bin/systemctl --user start "$server_unit" >/dev/null
server_pid="$(/usr/bin/systemctl --user show --property MainPID --value "$server_unit")"
if [[ ! "$server_pid" =~ ^[1-9][0-9]*$ ]]; then
    printf 'OpenRGB server did not start\n' >&2
    exit 1
fi

export OPENRGB_SERVER_PID="$server_pid"

# systemd considers the GUI process started before its hardware scan finishes.
# Wait for the saved controller layout to become visible before writing; this
# also handles a server that was started moments ago by another hook.
ready=0
for _ in {1..40}; do
    if /usr/bin/python3 "$repository_dir/src/openrgb-profile-sdk.py" --check "$profile" >/dev/null 2>&1; then
        ready=1
        break
    fi
    /usr/bin/sleep 0.5
done
if (( ready == 0 )); then
    printf 'OpenRGB hardware scan did not produce the saved controller layout\n' >&2
    exit 1
fi

exec /usr/bin/timeout 35 /usr/bin/python3 \
    "$repository_dir/src/openrgb-profile-sdk.py" "$profile"
