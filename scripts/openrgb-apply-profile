#!/usr/bin/env bash

set -euo pipefail

profile="${1:-}"
server_unit="app-openrgb@autostart.service"

if [[ -z "$profile" || ! -s "$profile" ]]; then
    printf 'Usage: %s PROFILE.json\n' "$0" >&2
    exit 2
fi

# Keep one OpenRGB process in sole ownership of the hardware. The OpenRGB 1.0
# standalone CLI races its asynchronous mode update against its synchronous LED
# update on ENE controllers, which can leave a DIMM partially programmed.
/usr/bin/systemctl --user start "$server_unit" >/dev/null
server_pid="$(/usr/bin/systemctl --user show --property MainPID --value "$server_unit")"
if [[ ! "$server_pid" =~ ^[1-9][0-9]*$ ]]; then
    printf 'OpenRGB server did not start\n' >&2
    exit 1
fi

export OPENRGB_SERVER_PID="$server_pid"
exec /usr/bin/timeout 35 /usr/bin/python3 \
    /home/aman/openrgb/src/openrgb-profile-sdk.py "$profile"
