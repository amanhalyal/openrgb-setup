#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-or-later

set -euo pipefail

script_path="$(readlink -f "${BASH_SOURCE[0]}")"
repository_dir="$(cd -- "$(dirname -- "$script_path")/.." && pwd)"
profile="$repository_dir/profiles/off.json"
runtime_dir=/run/openrgb-shutdown
server_port=6743
server_pid=""

cleanup() {
    if [[ "$server_pid" =~ ^[1-9][0-9]*$ ]]; then
        kill "$server_pid" 2>/dev/null || true
        wait "$server_pid" 2>/dev/null || true
    fi
}
trap cleanup EXIT INT TERM

mkdir -p "$runtime_dir"
exec 9>"$runtime_dir/hardware.lock"
/usr/bin/flock -w 10 9

# Seed an isolated, disposable config with the validated controller layout.
# OpenRGB otherwise detects the IT5711 ARGB zones at size zero under root.
rm -rf -- "$runtime_dir/config"
mkdir -p "$runtime_dir/config"
cp -- "$repository_dir/config/OpenRGB.json" \
    "$repository_dir/config/Configuration.json" "$runtime_dir/config/"

# Shutdown may begin while the desktop SDK server still owns the devices.
# Close every OpenRGB instance before starting one isolated server.
/usr/bin/pkill -TERM -x openrgb 2>/dev/null || true
for _ in {1..20}; do
    /usr/bin/pgrep -x openrgb >/dev/null 2>&1 || break
    /usr/bin/sleep 0.1
done
/usr/bin/pkill -KILL -x openrgb 2>/dev/null || true

QT_QPA_PLATFORM=offscreen /usr/bin/openrgb \
    --server --server-port "$server_port" --noautoconnect \
    --config "$runtime_dir/config" >"$runtime_dir/server.log" 2>&1 &
server_pid=$!

export XDG_RUNTIME_DIR="$runtime_dir"
export OPENRGB_SDK_PORT="$server_port"
export OPENRGB_SERVER_PID="$server_pid"

ready=0
for _ in {1..40}; do
    if /usr/bin/python3 "$repository_dir/src/openrgb-profile-sdk.py" \
        --check "$profile" >/dev/null 2>&1; then
        ready=1
        break
    fi
    kill -0 "$server_pid" 2>/dev/null || break
    /usr/bin/sleep 0.5
done
if (( ready == 0 )); then
    printf 'Shutdown OpenRGB server did not detect the saved controller layout\n' >&2
    exit 1
fi

/usr/bin/timeout 35 /usr/bin/python3 \
    "$repository_dir/src/openrgb-profile-sdk.py" "$profile"
