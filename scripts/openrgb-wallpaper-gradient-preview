#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-or-later

set -euo pipefail

script_path="$(readlink -f "${BASH_SOURCE[0]}")"
script_dir="$(dirname -- "$script_path")"
repository_dir="$(cd -- "$script_dir/.." && pwd)"
profile_dir="${OPENRGB_PROFILE_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/OpenRGB/profiles}"
template="$repository_dir/profiles/cathedral-inferno.json"
output="$profile_dir/wallpaper-gradient-preview.json"
wallpaper=""
colors=3
minimum_brightness=72
apply=1

usage() {
    cat <<'EOF'
Usage: openrgb-wallpaper-gradient-preview [options] [WALLPAPER]

Extract a wallpaper palette and preview it as an OpenRGB Custom Gradient Wave.
With no WALLPAPER argument, use Noctalia's current wallpaper.

Options:
  --template PROFILE.json       Custom Gradient Wave profile used for layout
  --output PROFILE.json         Generated preview profile location
  --colors 2|3|4|5              Number of extracted colors (default: 3)
  --minimum-brightness 0-255    Raise very dark colors for LEDs (default: 72)
  --no-apply                    Generate and print the palette without applying it
  -h, --help                    Show this help
EOF
}

die() {
    printf 'error: %s\n' "$*" >&2
    exit 1
}

while (( $# )); do
    case "$1" in
        --template)
            (( $# >= 2 )) || die "--template requires a path"
            template="$2"
            shift 2
            ;;
        --output)
            (( $# >= 2 )) || die "--output requires a path"
            output="$2"
            shift 2
            ;;
        --colors)
            (( $# >= 2 )) || die "--colors requires a value"
            colors="$2"
            shift 2
            ;;
        --minimum-brightness)
            (( $# >= 2 )) || die "--minimum-brightness requires a value"
            minimum_brightness="$2"
            shift 2
            ;;
        --no-apply)
            apply=0
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            shift
            (( $# <= 1 )) || die "only one wallpaper may be specified"
            wallpaper="${1:-}"
            shift "$#"
            ;;
        -*)
            die "unknown option: $1"
            ;;
        *)
            [[ -z "$wallpaper" ]] || die "only one wallpaper may be specified"
            wallpaper="$1"
            shift
            ;;
    esac
done

if [[ -z "$wallpaper" ]]; then
    wallpaper="$(timeout 5 /usr/bin/noctalia msg wallpaper-get 2>/dev/null | head -n 1 || true)"
fi
[[ -n "$wallpaper" ]] || die "Noctalia did not return a wallpaper; pass its path explicitly"
[[ -f "$wallpaper" ]] || die "wallpaper is not a file: $wallpaper"
[[ -f "$template" ]] || die "template profile is not a file: $template"

wallpaper="$(readlink -f "$wallpaper")"
template="$(readlink -f "$template")"
mkdir -p -- "$(dirname -- "$output")"

runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
mkdir -p -- "$runtime_dir"
exec 9>"$runtime_dir/openrgb-wallpaper-profile.lock"
if ! /usr/bin/flock -w 60 9; then
    die "timed out waiting for the OpenRGB profile lock"
fi

/usr/bin/python3 "$repository_dir/src/wallpaper-gradient-profile.py" \
    "$wallpaper" \
    --template "$template" \
    --output "$output" \
    --colors "$colors" \
    --minimum-brightness "$minimum_brightness"

if (( apply == 0 )); then
    exit 0
fi

"$script_dir/openrgb-apply-profile" "$output"

# Keep idle restore and the next wallpaper-change event aware that the preview,
# rather than the previously mapped wallpaper profile, is now active.
state_file="$runtime_dir/openrgb-wallpaper-profile.current"
state_tmp="$state_file.tmp.$$"
printf '%s\n' "$(readlink -f "$output")" >"$state_tmp"
mv -f -- "$state_tmp" "$state_file"
printf 'Previewing %s on OpenRGB\n' "${wallpaper##*/}"
